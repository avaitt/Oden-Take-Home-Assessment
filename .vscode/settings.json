{
  // Use the project's own virtual environment for scripts, terminals and notebook kernels
  // (it has every package in requirements.txt; system/Anaconda Pythons do not).
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Run each notebook from its own folder: the notebooks find ../src and ../outputs relative to it.
  "jupyter.notebookFileRoot": "${fileDirname}",

  // Keep the virtualenv out of search and the file watcher.
  "search.exclude": { "**/.venv": true },
  "files.watcherExclude": { "**/.venv/**": true }
}
